# iOS releases: signs the app on CI and uploads it to TestFlight.
# Run from ios/: bundle exec fastlane ios <lane>
#
# Needs:
#   APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID,
#   APP_STORE_CONNECT_KEY_P8_BASE64   App Store Connect API key (.p8, base64)
#   APPLE_TEAM_ID                     10 character team id
#   IOS_DIST_CERT_P12_BASE64          Apple Distribution certificate (.p12, base64)
#   IOS_DIST_CERT_PASSWORD            password of that .p12

require "base64"
require "tmpdir"

default_platform(:ios)

APP_ID = "de.karancode.gridMaster"

platform :ios do
  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Import the distribution certificate and fetch an App Store profile"
  private_lane :signing do
    setup_ci
    cert_path = File.join(Dir.tmpdir, "dist.p12")
    File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12_BASE64")))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ""
    )
    get_provisioning_profile(app_identifier: APP_ID, filename: "appstore.mobileprovision")
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )
  end

  desc "Build a signed release IPA"
  lane :build do |options|
    api_key
    signing
    build_number = options[:build_number] ||
                   latest_testflight_build_number(app_identifier: APP_ID, initial_build_number: 0) + 1
    Dir.chdir("../..") do
      sh("flutter", "build", "ios", "--release", "--no-codesign", "--build-number=#{build_number}")
    end
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] }
      },
      output_directory: "../build/ios/ipa",
      output_name: "GridMaster.ipa"
    )
  end

  desc "Build and upload to TestFlight"
  lane :deploy do
    build
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
